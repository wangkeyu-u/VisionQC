{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqc.example/schemas/visionqc-deployment-pack-v2.schema.json",
  "title": "VisionQC resolved Deployment Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_key", "version", "display_name", "tenant", "input_mode", "products", "stations", "field_mapping", "model", "policy", "connectors", "edge_gateway", "industry_pack", "tenant_overlay", "collection", "risk_strategy", "workflow", "permissions", "retention", "localization", "validation", "integrity", "migration"],
  "properties": {
    "schema_version": {"const": "visionqc.deployment-pack.v2"},
    "pack_key": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "tenant": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": false},
    "input_mode": {"enum": ["api_upload", "folder_watch", "usb_camera"]},
    "products": {"type": "array", "minItems": 1},
    "stations": {"type": "array", "minItems": 1},
    "field_mapping": {"type": "object", "required": ["product_code", "product_revision", "batch_no", "station_code", "captured_at", "source"]},
    "field_labels": {"type": "object"},
    "model": {"type": "object"},
    "policy": {"type": "object"},
    "connectors": {"type": "object", "required": ["mes", "qms"]},
    "edge_gateway": {"type": "object", "required": ["gateway_id", "target_tenant_id", "watch"]},
    "industry_pack": {"type": "object", "required": ["key", "version", "sha256"]},
    "tenant_overlay": {"type": "object", "required": ["key", "version", "sha256"]},
    "industry": {"type": "string"},
    "terminology": {"type": "object"},
    "collection": {"type": "object"},
    "risk_strategy": {"type": "object"},
    "workflow": {"type": "object"},
    "permissions": {"type": "object"},
    "retention": {"type": "object"},
    "localization": {"type": "object"},
    "validation": {"type": "object", "required": ["status", "validator", "checks"]},
    "integrity": {"type": "object", "required": ["algorithm", "manifest_sha256", "canonicalization"]},
    "migration": {"type": "object", "required": ["from_schema_versions", "strategy", "notes"]},
    "metadata": {"type": "object"}
  }
}
