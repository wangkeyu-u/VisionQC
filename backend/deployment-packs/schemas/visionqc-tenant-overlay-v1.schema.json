{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visionqc.example/schemas/visionqc-tenant-overlay-v1.schema.json",
  "title": "VisionQC tenant/site overlay v1",
  "type": "object",
  "required": ["schema_version", "overlay_key", "version", "display_name", "industry_pack", "tenant", "site", "input_mode", "products", "stations", "edge_gateway", "validation", "integrity", "migration"],
  "properties": {
    "schema_version": {"const": "visionqc.tenant-overlay.v1"},
    "overlay_key": {"type": "string"},
    "version": {"type": "string"},
    "display_name": {"type": "string"},
    "industry_pack": {"type": "object", "required": ["key", "version", "sha256"]},
    "tenant": {"type": "object", "required": ["id", "name"]},
    "site": {"type": "object", "required": ["id", "name"]},
    "input_mode": {"enum": ["api_upload", "folder_watch", "usb_camera"]},
    "products": {"type": "array", "minItems": 1},
    "stations": {"type": "array", "minItems": 1},
    "edge_gateway": {"type": "object", "required": ["gateway_id", "target_tenant_id", "watch"]},
    "validation": {"type": "object"},
    "integrity": {"type": "object"},
    "migration": {"type": "object"}
  }
}
