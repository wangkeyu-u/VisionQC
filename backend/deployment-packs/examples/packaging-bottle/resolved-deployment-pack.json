    "watch": {
      "root": "./incoming",
      "relative_path_regex": "^cell/(?P<station_code>CELL-[A-Z0-9_-]+)/date/(?P<date>[0-9]{4}/[0-9]{2}/[0-9]{2})$",
      "filename_regex": "^(?P<product>[A-Z0-9_-]+)__lot=(?P<batch>[A-Z0-9_-]+)__captured=(?P<captured_at>[0-9]{8}T[0-9]{6})__seq=(?P<sequence>[0-9]{6})\\.(?P<extension>png|jpe?g)$",
      "capture_map": {
        "product_code": "product",
        "batch_no": "batch",
        "station_code": "station_code",
        "captured_at": "captured_at"
      },
      "defaults": {
        "product_revision": "REV-UNSPECIFIED"
      },
      "source": "edge-camera/packaging",
      "allowed_extensions": [
        ".png",
        ".jpg",
        ".jpeg"
      ],
      "timestamp_formats": [
        "%Y%m%dT%H%M%S"
      ],
      "timezone_offset": "+00:00",
      "stable_for_seconds": 1.0,
      "archive_subdir": ".archive",
      "quarantine_subdir": ".quarantine"
    },
    "camera": {
      "optional": true,
      "default_index": 0,
      "output_format": "jpeg"
    },
    "queue": {
      "implementation": "sqlite-wal",
      "at_least_once_upload": true,
      "idempotency": "content-and-context-sha256"
    },
    "privacy": {
      "local_processing_default": true,
      "upload_requires_explicit_consent": true,
      "secret_values_never_in_pack": true
    }
  },
  "risk_strategy": {
    "name": "dual-threshold-human-accountable",
    "policy": {
      "version": "packaging-risk-policy-1.0.0",
      "default": {
        "product_code": null,
        "station_code": null,
        "review_threshold": 0.3,
        "hold_threshold": 0.7
      },
      "overrides": []
    },
    "model_output_semantics": "Anomaly evidence only; semantic defect confirmation stays with an authorized reviewer.",
    "fail_safe_route": "REVIEW_REQUIRED",
    "automatic_release_allowed": false,
    "approval_roles": [
      "quality_manager",
      "auditor"
    ]
  },
  "workflow": {
    "states": [
      "RECEIVED",
      "VALIDATED",
      "INFERENCING",
      "REVIEW_REQUIRED",
      "BATCH_HELD",
      "ACTION_PENDING",
      "ACTION_COMPLETED",
      "CLOSED"
    ],
    "transitions": [
      {
        "from": "RECEIVED",
        "to": "VALIDATED"
      },
      {
        "from": "REVIEW_REQUIRED",
        "to": "ACTION_PENDING"
      },
      {
        "from": "BATCH_HELD",
        "to": "ACTION_PENDING"
      },
      {
        "from": "ACTION_PENDING",
        "to": "ACTION_COMPLETED"
      }
    ],
    "external_action_approval_required": true,
    "human_review_required_for": [
      "REVIEW_REQUIRED",
      "BATCH_HELD",
      "INFERENCE_FAILED"
    ]
  },
  "permissions": {
    "roles": {
      "inspector": [
        "inspect",
        "review"
      ],
      "quality_manager": [
        "review",
        "approve_external_action",
        "close_incident"
      ],
      "fde": [
        "validate_pack",
        "draft_deployment"
      ],
      "auditor": [
        "read_audit"
      ]
    },
    "external_action_approval_roles": [
      "quality_manager"
    ],
    "deployment_approval_roles": [
      "quality_manager",
      "fde"
    ]
  },
  "retention": {
    "raw_image_days": 30,
    "metadata_days": 365,
    "local_processing_default": true,
    "delete_after_upload": false,
    "legal_hold_supported": true
  },
  "localization": {
    "default_locale": "en-US",
    "supported_locales": [
      "en-US",
      "zh-CN"
    ],
    "timezone": "+08:00",
    "terminology": {
      "batch_hold": "Lot hold",
      "review_required": "Review required"
