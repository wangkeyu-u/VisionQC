      "relative_path_regex": "^station/(?P<station_code>[A-Za-z0-9_-]+)$",
      "filename_regex": "^(?P<product>[A-Za-z0-9_-]+)__batch=(?P<batch>[A-Za-z0-9_-]+)__captured=(?P<captured_at>[0-9]{8}T[0-9]{6})__seq=(?P<sequence>[0-9]{6})\\.(?P<extension>png|jpe?g)$",
