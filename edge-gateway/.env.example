# Demo only: the gateway derives tenant, station and field mapping from this pack.
# Change one path to switch tenants; no source-code fork is required.
VQC_GATEWAY_MODE=demo
VQC_GATEWAY_ID=gateway-local
VQC_GATEWAY_PACK_PATH=../backend/deployment-packs/examples/electronics-transistor/resolved-deployment-pack.json
VQC_GATEWAY_BACKEND_URL=http://localhost:8000/api/v1
VQC_GATEWAY_WATCH_ROOT=./.visionqc-gateway/incoming
VQC_GATEWAY_DATA_DIR=./.visionqc-gateway
VQC_GATEWAY_STATUS_PORT=8090
VQC_GATEWAY_UPLOAD_ENABLED=false
VQC_GATEWAY_DATA_CONSENT=false

# Production: inject both values through an IdP/secret provider; do not commit them.
# VQC_GATEWAY_MODE=production
# VQC_GATEWAY_AUTH_TOKEN=<short-lived tenant-scoped edge_gateway token>
# VQC_GATEWAY_STATUS_TOKEN=<local status API token>
